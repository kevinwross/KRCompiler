#pragma once

// Minimal std::type_info for the KR32 C++ subset.
//
// The layout is the one docs/abi.md fixes: a vtable pointer, a name pointer,
// and flags. A class that derives from another appends its base's typeinfo as
// a fourth word — the single-inheritance form — which is the chain
// dynamic_cast walks. The compiler materializes one object per class as the
// weak global `_ZTI<Class>`, and `typeid` evaluates to a reference to it.

#include <exception>

namespace std {

class type_info {
public:
    type_info(const type_info&) = delete;
    type_info& operator=(const type_info&) = delete;

    // The source-level class name the compiler recorded in `_ZTS<Class>`.
    const char* name() const { return __name; }

    // Two type_info objects describe the same type when the compiler emitted
    // one; it emits one per class and the name is unique to it.
    bool operator==(const type_info& other) const { return __name == other.__name; }
    bool operator!=(const type_info& other) const { return __name != other.__name; }

    // An implementation-defined order, so a descriptor can key an ordered
    // container. The compiler emits one descriptor per class, so the address of
    // its name is stable for the life of the image and orders descriptors.
    bool before(const type_info& other) const { return __name < other.__name; }

    // The compiler's spelling of the name. In a hosted implementation this
    // carries a length prefix; here the name is the source spelling, so it is
    // the same string name() returns.
    const char* raw_name() const { return __name; }

private:
    const void* __vptr;
    const char* __name;
    unsigned int __flags;
};

// Thrown by a reference dynamic_cast whose check fails. Catching it by
// `std::exception&` works because the typeinfo chain records the base class.
class bad_cast : public exception {
public:
    bad_cast() {}
    virtual const char* what() const { return "std::bad_cast"; }
};

}  // namespace std
