#pragma once

// std::swap and std::move for the supported subset. Both are single function
// templates: an overload set under one name is not supported, so there is one
// swap and one move.

namespace std {

template <typename T>
T&& move(T& value) {
    return static_cast<T&&>(value);
}

template <typename T>
void swap(T& first, T& second) {
    T temporary = first;
    first = second;
    second = temporary;
}

}  // namespace std