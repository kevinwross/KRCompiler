#pragma once

// std::array for the C++ subset: a fixed-size array that knows its length.
//
// The element storage is a plain array member, so an instance has exactly the
// layout of `T[N]` with no other members, and `std::array<T, N>` costs what the
// array costs. `operator[]` does not check the index; `at` does and throws
// `std::out_of_range`, which the runtime's exception machinery carries.

#include <stddef.h>
#include <stdexcept>

namespace std {

template <typename T, size_t N>
class array {
public:
    array() : __elements() {}
    T& operator[](size_t index) { return __elements[index]; }
    const T& operator[](size_t index) const { return __elements[index]; }

    T& at(size_t index) {
        if (index >= N) {
            throw out_of_range("std::array::at");
        }
        return __elements[index];
    }
    const T& at(size_t index) const {
        if (index >= N) {
            throw out_of_range("std::array::at");
        }
        return __elements[index];
    }

    T& front() { return __elements[0]; }
    const T& front() const { return __elements[0]; }
    T& back() { return __elements[N - 1]; }
    const T& back() const { return __elements[N - 1]; }

    T* data() { return __elements; }
    const T* data() const { return __elements; }

    // The bound is a constant of the type, so these are compile-time answers.
    size_t size() const { return N; }
    bool empty() const { return N == 0; }

    void fill(const T& value) {
        size_t index = 0;
        while (index < N) {
            __elements[index] = value;
            index = index + 1;
        }
    }

    // A usable range for the range-for statement.
    T* begin() { return __elements; }
    T* end() { return __elements + N; }
    const T* begin() const { return __elements; }
    const T* end() const { return __elements + N; }

private:
    T __elements[N];
};

}  // namespace std
