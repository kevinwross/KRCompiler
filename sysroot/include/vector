#pragma once

// std::vector for the supported subset: contiguous heap storage with
// placement-new construction and explicit destruction, so element types may
// own resources. Elements are default-constructed and then assigned, which is
// what the compiler can lower today; a type therefore needs a default
// constructor and copy assignment. Storage comes from malloc; capacity growth
// moves the live elements into a fresh block and destroys the old ones.

#include <stddef.h>
#include <stdlib.h>

namespace std {

template <typename T>
class vector {
public:
    vector() : data_(0), size_(0), capacity_(0) {}

    vector(const vector& other) : data_(0), size_(0), capacity_(0) {
        reserve(other.size_);
        size_t index = 0;
        while (index < other.size_) {
            new (data_ + index) T;
            data_[index] = other.data_[index];
            ++index;
        }
        size_ = other.size_;
    }

    vector(vector&& other)
        : data_(other.data_), size_(other.size_), capacity_(other.capacity_) {
        other.data_ = 0;
        other.size_ = 0;
        other.capacity_ = 0;
    }

    ~vector() {
        destroy_all();
        free(data_);
    }

    vector& operator=(const vector& other) {
        if (this != &other) {
            clear();
            reserve(other.size_);
            size_t index = 0;
            while (index < other.size_) {
                new (data_ + index) T;
                data_[index] = other.data_[index];
                ++index;
            }
            size_ = other.size_;
        }
        return *this;
    }

    vector& operator=(vector&& other) {
        if (this != &other) {
            destroy_all();
            free(data_);
            data_ = other.data_;
            size_ = other.size_;
            capacity_ = other.capacity_;
            other.data_ = 0;
            other.size_ = 0;
            other.capacity_ = 0;
        }
        return *this;
    }

    size_t size() const { return size_; }
    size_t capacity() const { return capacity_; }
    bool empty() const { return size_ == 0; }

    T& operator[](size_t index) { return data_[index]; }
    const T& operator[](size_t index) const { return data_[index]; }
    T& front() { return data_[0]; }
    const T& front() const { return data_[0]; }
    T& back() { return data_[size_ - 1]; }
    const T& back() const { return data_[size_ - 1]; }

    T* data() { return data_; }
    const T* data() const { return data_; }
    T* begin() { return data_; }
    T* end() { return data_ + size_; }
    const T* begin() const { return data_; }
    const T* end() const { return data_ + size_; }

    void clear() {
        destroy_all();
        size_ = 0;
    }

    void reserve(size_t wanted) {
        if (wanted <= capacity_) {
            return;
        }
        size_t next = capacity_ == 0 ? 4 : capacity_;
        while (next < wanted) {
            next = next * 2;
        }
        const size_t count = size_;
        T* buffer = static_cast<T*>(malloc(sizeof(T) * next));
        size_t index = 0;
        while (index < count) {
            new (buffer + index) T;
            buffer[index] = data_[index];
            ++index;
        }
        destroy_all();
        free(data_);
        data_ = buffer;
        capacity_ = next;
        size_ = count;
    }

    void push_back(T value) {
        if (size_ == capacity_) {
            reserve(capacity_ == 0 ? 4 : capacity_ * 2);
        }
        new (data_ + size_) T;
        data_[size_] = value;
        ++size_;
    }

    void pop_back() {
        if (size_ > 0) {
            --size_;
            destroy(data_ + size_);
        }
    }

private:
    static void destroy(T* value) { delete value; }

    void destroy_all() {
        while (size_ > 0) {
            --size_;
            destroy(data_ + size_);
        }
    }

    T* data_;
    size_t size_;
    size_t capacity_;
};

} // namespace std
