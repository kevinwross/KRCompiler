#pragma once

// std::vector for the supported subset: contiguous heap storage, push_back,
// pop_back, element access, reserve and iteration. The storage is allocated
// with malloc, so the supported element types are trivially copyable scalars
// and records; the corpus uses those.

#include <stddef.h>
#include <stdlib.h>
#include <string.h>

namespace std {

template <typename T>
class vector {
public:
    vector() : data_(0), size_(0), capacity_(0) {}

    vector(const vector& other) : data_(0), size_(0), capacity_(0) {
        reserve(other.size_);
        size_t index = 0;
        while (index < other.size_) {
            data_[index] = other.data_[index];
            ++index;
        }
        size_ = other.size_;
    }

    vector(vector&& other)
        : data_(other.data_), size_(other.size_), capacity_(other.capacity_) {
        other.data_ = 0;
        other.size_ = 0;
        other.capacity_ = 0;
    }

    ~vector() { free(data_); }

    vector& operator=(const vector& other) {
        if (this != &other) {
            clear();
            reserve(other.size_);
            size_t index = 0;
            while (index < other.size_) {
                data_[index] = other.data_[index];
                ++index;
            }
            size_ = other.size_;
        }
        return *this;
    }

    vector& operator=(vector&& other) {
        if (this != &other) {
            free(data_);
            data_ = other.data_;
            size_ = other.size_;
            capacity_ = other.capacity_;
            other.data_ = 0;
            other.size_ = 0;
            other.capacity_ = 0;
        }
        return *this;
    }

    size_t size() const { return size_; }
    size_t capacity() const { return capacity_; }
    bool empty() const { return size_ == 0; }

    T& operator[](size_t index) { return data_[index]; }
    const T& operator[](size_t index) const { return data_[index]; }
    T& front() { return data_[0]; }
    const T& front() const { return data_[0]; }
    T& back() { return data_[size_ - 1]; }
    const T& back() const { return data_[size_ - 1]; }

    T* data() { return data_; }
    const T* data() const { return data_; }
    T* begin() { return data_; }
    T* end() { return data_ + size_; }
    const T* begin() const { return data_; }
    const T* end() const { return data_ + size_; }

    void clear() { size_ = 0; }

    void reserve(size_t wanted) {
        if (wanted <= capacity_) {
            return;
        }
        size_t next = capacity_ == 0 ? 4 : capacity_;
        while (next < wanted) {
            next = next * 2;
        }
        T* buffer = static_cast<T*>(malloc(sizeof(T) * next));
        size_t index = 0;
        while (index < size_) {
            buffer[index] = data_[index];
            ++index;
        }
        free(data_);
        data_ = buffer;
        capacity_ = next;
    }

    void push_back(const T& value) {
        if (size_ == capacity_) {
            reserve(capacity_ == 0 ? 4 : capacity_ * 2);
        }
        data_[size_] = value;
        ++size_;
    }

    void pop_back() {
        if (size_ > 0) {
            --size_;
        }
    }

    friend bool operator==(const vector& left, const vector& right) {
        if (left.size_ != right.size_) {
            return false;
        }
        size_t index = 0;
        while (index < left.size_) {
            if (!(left.data_[index] == right.data_[index])) {
                return false;
            }
            ++index;
        }
        return true;
    }
    friend bool operator!=(const vector& left, const vector& right) {
        return !(left == right);
    }

private:
    T* data_;
    size_t size_;
    size_t capacity_;
};

} // namespace std
