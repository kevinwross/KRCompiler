#pragma once

// std::unique_ptr for the supported subset: single ownership of an object
// allocated with `new`, move construction and move assignment, and the observer
// accessors. Copying is deleted, so the compiler selects the move constructor
// for a returned or explicitly moved value.
//
// make_unique is one template for every arity, using pack expansion inside an
// expression: `new T(args...)`.
//
// KR16 does not support aggregate returns, so on that target make_unique does
// not compile -- the same limit that stops any function returning a record by
// value. Construct the owner explicitly there: unique_ptr<T> owner(new T(...));
// KR32 compiles and runs it.

namespace std {

template <typename T>
class unique_ptr {
public:
    unique_ptr() : pointer(0) {}
    explicit unique_ptr(T* value) : pointer(value) {}

    // The member is assigned in the body rather than in a member initializer,
    // which cannot read another object's member through a reference parameter.
    unique_ptr(unique_ptr&& other) : pointer(0) {
        pointer = other.pointer;
        other.pointer = 0;
    }

    unique_ptr& operator=(unique_ptr&& other) {
        if (this != &other) {
            T* previous = pointer;
            pointer = other.pointer;
            other.pointer = 0;
            delete previous;
        }
        return *this;
    }

    unique_ptr(const unique_ptr& other) = delete;
    unique_ptr& operator=(const unique_ptr& other) = delete;

    ~unique_ptr() { delete pointer; }

    T& operator*() const { return *pointer; }
    T* operator->() const { return pointer; }
    T* get() const { return pointer; }
    explicit operator bool() const { return pointer != 0; }

    T* release() {
        T* value = pointer;
        pointer = 0;
        return value;
    }

    void reset(T* value = 0) {
        T* previous = pointer;
        pointer = value;
        delete previous;
    }

    void swap(unique_ptr& other) {
        T* temporary = pointer;
        pointer = other.pointer;
        other.pointer = temporary;
    }

private:
    T* pointer;
};

// One template covers every arity now that variadic templates and pack
// expansion exist, so there is no overload set to collide.
template <typename T, typename... Args>
unique_ptr<T> make_unique(Args... args) {
    return unique_ptr<T>(new T(args...));
}

}  // namespace std