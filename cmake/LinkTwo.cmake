if(NOT DEFINED KRC OR NOT DEFINED KRLD OR NOT DEFINED SOURCE1 OR
   NOT DEFINED SOURCE2 OR NOT DEFINED RUNTIME OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "LinkTwo.cmake requires KRC, KRLD, SOURCE1, SOURCE2, RUNTIME, OUTPUT")
endif()

set(object1 "${OUTPUT}.one.kro")
set(object2 "${OUTPUT}.two.kro")
file(REMOVE "${object1}" "${object2}" "${OUTPUT}")
execute_process(COMMAND "${KRC}" -c "${SOURCE1}" -o "${object1}"
                RESULT_VARIABLE first_result)
if(NOT first_result EQUAL 0)
    message(FATAL_ERROR "krc -c failed for SOURCE1 with ${first_result}")
endif()
execute_process(COMMAND "${KRC}" -c "${SOURCE2}" -o "${object2}"
                RESULT_VARIABLE second_result)
if(NOT second_result EQUAL 0)
    message(FATAL_ERROR "krc -c failed for SOURCE2 with ${second_result}")
endif()
execute_process(COMMAND "${KRLD}" "${object1}" "${object2}" "${RUNTIME}" -o "${OUTPUT}"
                RESULT_VARIABLE link_result)
if(NOT link_result EQUAL 0)
    message(FATAL_ERROR "krld failed with ${link_result}")
endif()
if(NOT EXISTS "${OUTPUT}")
    message(FATAL_ERROR "krld did not create ${OUTPUT}")
endif()
file(SIZE "${OUTPUT}" output_size)
if(output_size LESS 64)
    message(FATAL_ERROR "linked image is too small")
endif()
